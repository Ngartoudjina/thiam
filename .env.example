#-----------------------------------------------------------------------------
# Bijouterie THIAM 24 Carats — variables d'environnement
# Copier ce fichier en `.env.local` puis renseigner les valeurs.
# Toutes les variables sont optionnelles : le site démarre sans aucune d'elles
# et affiche alors le contenu livré avec la maquette.
#-----------------------------------------------------------------------------

# URL canonique de production. Sert aux balises canoniques, à l'Open Graph,
# au sitemap et au robots.txt. Sans slash final.
NEXT_PUBLIC_SITE_URL="https://www.thiam24carats.com"

# Adresse et coordonnées affichées tant que le tableau de bord n'en a pas
# d'autres (rubrique Coordonnées).
NEXT_PUBLIC_STREET_ADDRESS=""
NEXT_PUBLIC_CONTACT_EMAIL="thiam24carats@gmail.com"

# Carte intégrée. Par défaut le site affiche un plan OpenStreetMap.
# Pour une carte Google : sur la fiche de l'établissement, « Partager →
# Intégrer une carte », copier l'adresse de l'attribut src du cadre proposé.
# Elle commence par https://www.google.com/maps/embed?pb=
NEXT_PUBLIC_MAPS_EMBED_SRC=""

# Réseaux sociaux. Les icônes du pied de page n'apparaissent que si renseignés.
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""

# Vérification Google Search Console (contenu de la balise meta).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

#-----------------------------------------------------------------------------
# Base de données — Neon (Postgres serverless)
#
# Contenu du site, comptes du tableau de bord, demandes de contact, abonnés.
# Sans elle, le site fonctionne sur le contenu de la maquette et /admin
# affiche une page d'installation. Rien ne casse.
#
# `neon deploy` (CLI Neon) ou l'intégration Neon de Vercel la renseignent
# d'eux-mêmes. Sinon : console Neon › projet › Connect, copier l'adresse.
#-----------------------------------------------------------------------------

DATABASE_URL=""

#-----------------------------------------------------------------------------
# Stockage des images téléversées — Vercel Blob
#
# Vercel › Storage › Create › Blob, puis relier le magasin au projet : le
# jeton est ajouté automatiquement. En local, sans jeton, les images sont
# écrites dans .data/media et servies par /media/… (STORAGE_DRIVER=local).
#-----------------------------------------------------------------------------

# Vercel relie désormais un magasin par OIDC : il pose BLOB_STORE_ID, sans
# secret durable. Les scripts lancés en local (import Supabase) ont, eux,
# besoin d'un jeton : cocher « Add a read-write token » à la connexion.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

# `blob` ou `local`. Laisser vide pour le choix automatique (voir ci-dessus).
# `local` convient aussi à un hébergement sur serveur classique, avec disque.
STORAGE_DRIVER=""
# Dossier du stockage local (par défaut : .data/media).
LOCAL_MEDIA_DIR=""

#-----------------------------------------------------------------------------
# Relais facultatifs — serveur uniquement
#
# Les demandes de contact et les inscriptions sont toujours enregistrées en
# base (rubriques Demandes et Abonnés du tableau de bord). Ces adresses les
# relaient en plus vers un outil de la maison : Make, Zapier, CRM, e-mail…
#-----------------------------------------------------------------------------

CONTACT_WEBHOOK_URL=""
NEWSLETTER_WEBHOOK_URL=""

#-----------------------------------------------------------------------------
# Reprise de l'ancien projet Supabase — uniquement pour `npm run import:supabase`
# À supprimer une fois l'import fait. Ne jamais préfixer NEXT_PUBLIC_.
#-----------------------------------------------------------------------------

SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
