#-----------------------------------------------------------------------------
# Bijouterie THIAM 24 Carats — variables d'environnement
# Copier ce fichier en `.env.local` puis renseigner les valeurs.
# Toutes les variables sont optionnelles : le site démarre sans aucune d'elles.
#-----------------------------------------------------------------------------

# URL canonique de production. Sert aux balises canoniques, à l'Open Graph,
# au sitemap et au robots.txt. Sans slash final.
NEXT_PUBLIC_SITE_URL="https://www.thiam24carats.com"

# Adresse et coordonnées affichées quand la maison les communique.
NEXT_PUBLIC_STREET_ADDRESS=""
NEXT_PUBLIC_CONTACT_EMAIL="thiam24carats@gmail.com"

# Plan d'accès.
# `MAPS_QUERY` alimente les liens « itinéraire » et « copier l'adresse ».
# Carte intégrée.
#
# Par défaut le site affiche OpenStreetMap : Google renvoie
# « X-Frame-Options: SAMEORIGIN » sur ses URL « output=embed », que le
# navigateur refuse alors d'afficher dans un cadre.
#
# Pour une carte Google : sur la fiche de l'établissement, « Partager →
# Intégrer une carte », copier l'adresse contenue dans l'attribut src du
# cadre proposé. Elle commence par https://www.google.com/maps/embed?pb=
NEXT_PUBLIC_MAPS_EMBED_SRC=""

# Réseaux sociaux. Les icônes du pied de page n'apparaissent que si renseignés.
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""

# Vérification Google Search Console (contenu de la balise meta).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

#-----------------------------------------------------------------------------
# Supabase — base de contenu, authentification et stockage des images
#
# Sans ces variables, le site fonctionne sur le contenu livré avec la maquette
# et /admin affiche une page d'installation. Rien ne casse.
# Projet > Settings > API sur supabase.com.
#-----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

#-----------------------------------------------------------------------------
# Serveur uniquement — jamais exposé au navigateur
#-----------------------------------------------------------------------------

# Clé de service Supabase. Contourne les règles d'accès : elle ne sert qu'au
# nettoyage des fichiers orphelins dans le stockage. À ne jamais préfixer
# NEXT_PUBLIC_, à ne jamais committer.
SUPABASE_SERVICE_ROLE_KEY=""

# Destination des demandes de rendez-vous (CRM, Make/Zapier, e-mail
# transactionnel, Google Sheet…). Sans cette valeur, la demande est acceptée
# et tracée dans les journaux du serveur.
CONTACT_WEBHOOK_URL=""

# Destination des inscriptions à la lettre de la maison.
NEWSLETTER_WEBHOOK_URL=""
